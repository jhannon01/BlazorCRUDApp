@page "/songs"
@using BlazorCRUDApp.Core.Entities
@using BlazorCRUDApp.Core.Interfaces
@using BlazorCRUDApp.Web.Components.Helpers
@inject ISongService SongService
@inject NavigationManager NavigationManager

<h3>Songs</h3>

<table>
    <thead><tr><th>Title</th><th>Artist</th></tr></thead>
    <tbody>
        @foreach (var p in songs)
        {
            <tr>
                <td>@p.Title</td>
                <td>@p.Artist</td>
                <td>
                    <button @onclick="() => EditClick(p)">Edit</button>
                    <button @onclick="() => Delete(p.Id)">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (editClicked && songParameter != null)
{
            <EditDialog 
                Song="songParameter"
                OnClose="HandleCloseDialog">
            </EditDialog>
}

@code {
    private List<Song> songs = new();
    private Boolean editClicked = false;
    private Song? songParameter = null;
    protected override async Task OnInitializedAsync()
    {
        songs = await SongService.GetAll();
    }
    void EditClick(Song song)
    {
        songParameter = song;
        editClicked = true;
    }
    protected async Task Delete(int id)
    {
        await SongService.Delete(id);
        songs.RemoveAll(s => s.Id == id);
        StateHasChanged();
    }
    private void HandleCloseDialog()
    {
        editClicked = false;
        songParameter = null;
    }
}